# Prompt Code Environment Configuration
# Copy this file to .env for local development. Never commit .env.

HOST=127.0.0.1
PORT=8000
STATIC_DIR=static

# Open-weight default models (Gemma is the default path)
DEFAULT_MODEL=gemma-4-31b-it
FALLBACK_MODEL=gemma-4-26b-a4b-it

# Server-side Gemma API credentials (optional for client-side demo mode, required for live model calls)
# GEMMA_API_KEY=your_gemma_api_key_here
GEMMA_API_BASE=https://api.gemma.google/v1

# Ollama local inference (default: uses your local Ollama instance)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_FALLBACK=llama3.2:latest

# Optional external providers (opt-in; open-weight Gemma remains the default)
# OPENAI_API_KEY=your_openai_key_here
# GEMINI_API_KEY=your_gemini_key_here

# Limits & Quotas
MAX_INPUT_LEN=4000
FREE_TRY_LIMIT=3

# Rate Limiting & Request Queuing
MAX_CONCURRENT_INFERENCES=1
RATE_LIMIT_PER_MINUTE=10
QUEUE_TIMEOUT_SECS=15
